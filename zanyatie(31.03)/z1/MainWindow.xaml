<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный дневник студента" Height="550" Width="850">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding AddGradeCommand}"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding EditGradeCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding DeleteGradeCommand}"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="_Выход" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Расписание">
                <MenuItem Header="_Показать расписание" Command="{Binding ShowScheduleCommand}"/>
            </MenuItem>
            <MenuItem Header="_Оценки">
                <MenuItem Header="_Добавить оценку" Command="{Binding AddGradeCommand}"/>
                <MenuItem Header="_Редактировать оценку" Command="{Binding EditGradeCommand}"/>
                <MenuItem Header="_Удалить оценку" Command="{Binding DeleteGradeCommand}"/>
            </MenuItem>
        </Menu>

        <ToolBar DockPanel.Dock="Top">
            <Button Content="Добавить оценку" Command="{Binding AddGradeCommand}" ToolTip="Ctrl+N"/>
            <Button Content="Редактировать оценку" Command="{Binding EditGradeCommand}" ToolTip="Ctrl+E"/>
            <Button Content="Удалить оценку" Command="{Binding DeleteGradeCommand}" ToolTip="Del"/>
        </ToolBar>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Электронный дневник студента" FontSize="20" FontWeight="Bold" 
                       HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TabControl Grid.Row="1">
                <TabItem Header="Расписание занятий">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Расписание на неделю" FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="ScheduleGrid" Grid.Row="1" AutoGenerateColumns="True" 
                                  IsReadOnly="True"/>
                    </Grid>
                </TabItem>

                <TabItem Header="Оценки">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Список предметов и оценки" FontSize="16" FontWeight="Bold" 
                                   Margin="0,0,0,10"/>

                        <DataGrid x:Name="GradesGrid" Grid.Row="1" AutoGenerateColumns="True" 
                                  Margin="0,0,0,10" IsReadOnly="True"
                                  SelectedItem="{Binding SelectedGrade}"/>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Добавить" Command="{Binding AddGradeCommand}" Width="80" Margin="5"/>
                            <Button Content="Редактировать" Command="{Binding EditGradeCommand}" Width="80" Margin="5"/>
                            <Button Content="Удалить" Command="{Binding DeleteGradeCommand}" Width="80" Margin="5"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>