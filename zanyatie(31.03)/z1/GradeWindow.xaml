<Window x:Class="z1.GradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оценка" Height="250" Width="350">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Предмет:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="SubjectCombo" Grid.Row="0" Grid.Column="1" Margin="5" SelectedIndex="0">
            <ComboBoxItem Content="Математика"/>
            <ComboBoxItem Content="Физика"/>
            <ComboBoxItem Content="Программирование"/>
            <ComboBoxItem Content="Английский"/>
            <ComboBoxItem Content="История"/>
            <ComboBoxItem Content="Русский язык"/>
            <ComboBoxItem Content="Литература"/>
            <ComboBoxItem Content="Химия"/>
            <ComboBoxItem Content="Биология"/>
            <ComboBoxItem Content="Физкультура"/>
            <ComboBoxItem Content="ОБЖ"/>
        </ComboBox>

        <TextBlock Text="Оценка:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <ComboBox x:Name="GradeCombo" Grid.Row="1" Grid.Column="1" Margin="5" SelectedIndex="2">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
            <ComboBoxItem Content="7"/>
            <ComboBoxItem Content="8"/>
            <ComboBoxItem Content="9"/>
            <ComboBoxItem Content="10"/>
        </ComboBox>

        <TextBlock Text="Дата:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="5"/>
        <DatePicker x:Name="DatePicker" Grid.Row="2" Grid.Column="1" Margin="5"/>

        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="5">
            <Button Content="OK" Width="60" Margin="5" Click="OkButton_Click"/>
            <Button Content="Отмена" Width="60" Margin="5" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>