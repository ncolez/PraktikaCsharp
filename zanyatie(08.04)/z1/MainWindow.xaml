<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:z1"
        Title="Электронный дневник"
        Height="650"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Storyboard x:Key="LoadingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation 
                Storyboard.TargetName="LoadingIcon"
                Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                From="0" To="360" Duration="0:0:1"/>
        </Storyboard>

        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation 
                Storyboard.TargetName="GradesListView"
                Storyboard.TargetProperty="Opacity"
                From="1" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation 
                Storyboard.TargetName="GradesListView"
                Storyboard.TargetProperty="Opacity"
                From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECF0F1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C3E50">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Электронный дневник"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding CurrentUser.FullName}"
                               Foreground="#BDC3C7"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <TextBlock Text="{Binding CurrentUser.Role}"
                               Foreground="#3498DB"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Button Content="Загрузить"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#3498DB"
                            Height="30"
                            Width="80"
                            Margin="5,0"/>

                    <Button Content="Сохранить"
                            Command="{Binding SaveDataCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#27AE60"
                            Height="30"
                            Width="80"
                            Margin="5,0"/>

                    <Button Content="Чат"
                            Command="{Binding OpenChatCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#9B59B6"
                            Height="30"
                            Width="80"
                            Margin="5,0"/>

                    <Button Content="Задания"
                            Command="{Binding OpenAssignmentsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#E67E22"
                            Height="30"
                            Width="80"
                            Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F8F9FA"
                    Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Студенты"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="15,15,0,10"/>

                    <ListBox x:Name="StudentsList"
                             ItemsSource="{Binding Students}" 
                             SelectedItem="{Binding SelectedStudent}"
                             DisplayMemberPath="FullName"
                             Style="{StaticResource ModernListBox}"
                             Height="Auto"
                             Margin="10,0,10,10"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#F8F9FA">
                <StackPanel Margin="15">

                    <TextBlock Text="{Binding SelectedStudent.FullName, FallbackValue='Выберите студента'}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,5,0,10"/>

                    <Border Background="#EBF5FB"
                            Padding="15"
                            Margin="0,0,0,15">
                        <TextBlock FontSize="14"
                                   Foreground="#2C3E50">
                            <Run Text="Средний балл:" FontWeight="Normal"/>
                            <Run Text="{Binding SelectedStudentAverageGrade, Mode=OneWay}"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="#3498DB"/>
                        </TextBlock>
                    </Border>

                    <Border Height="1" Background="#E0E4E8" Margin="0,0,0,12"/>

                    <ListView x:Name="GradesListView"
                              ItemsSource="{Binding SelectedStudentGrades}"
                              BorderThickness="0"
                              Background="Transparent"
                              Height="300"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              MouseDoubleClick="GradesListView_MouseDoubleClick">

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F0F0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Предмет" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4">
                                                <TextBlock Text="{Binding Subject}"
                                                           FontSize="13"
                                                           Foreground="#34495E"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Оценка" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4">
                                                <TextBlock x:Name="GradeTextBlock"
                                                           Text="{Binding GradeValue}"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="#27AE60"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="Дата" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,4">
                                                <TextBlock Text="{Binding Date, StringFormat='dd.MM.yyyy'}"
                                                           FontSize="11"
                                                           Foreground="#95A5A6"
                                                           HorizontalAlignment="Right"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <Button Content="Добавить оценку"
                            Command="{Binding AddGradeCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#27AE60"
                            HorizontalAlignment="Right"
                            Width="120"
                            Height="34"
                            Margin="0,15,0,0"
                            Visibility="{Binding CanEditGrades, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="White"
                CornerRadius="8"
                Padding="20,15"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="LoadingIcon"
                           Text="⏳"
                           FontSize="18"
                           Margin="0,0,10,0"
                           RenderTransformOrigin="0.5,0.5">
                    <TextBlock.RenderTransform>
                        <RotateTransform/>
                    </TextBlock.RenderTransform>
                </TextBlock>
                <TextBlock Text="Загрузка данных..."
                           Foreground="#2C3E50"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>