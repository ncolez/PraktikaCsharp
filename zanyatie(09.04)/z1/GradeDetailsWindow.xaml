<Window x:Class="z1.GradeDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали оценки"
        Height="200"
        Width="300"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        WindowStyle="None"
        Background="Transparent">

    <Border x:Name="MainBorder"
            Background="White"
            CornerRadius="10"
            Padding="20"
            BorderBrush="#3498DB"
            BorderThickness="2">

        <StackPanel>
            <TextBlock x:Name="SubjectText"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#2C3E50"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Оценка:"
                           FontSize="14"
                           Foreground="#7F8C8D"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="GradeText"
                           Grid.Column="1"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#27AE60"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Дата:"
                           FontSize="14"
                           Foreground="#7F8C8D"
                           Margin="0,0,10,0"/>

                <TextBlock x:Name="DateText"
                           Grid.Column="1"
                           FontSize="14"
                           Foreground="#2C3E50"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>