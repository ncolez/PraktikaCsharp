<Window x:Class="z1.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Чат"
        Height="450"
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2C3E50">
            <TextBlock Text="Чат"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="15,0,0,0"/>
        </Border>

        <ListBox x:Name="MessagesList"
                 Grid.Row="1"
                 BorderThickness="0"
                 Background="#F8F9FA"
                 Margin="10"/>

        <Border Grid.Row="2"
                Background="#F8F9FA"
                Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageBox"
                         Grid.Column="0"
                         Height="38"
                         FontSize="13"
                         Padding="12,0"
                         BorderBrush="#BDC3C7"
                         BorderThickness="1"
                         VerticalContentAlignment="Center"
                         KeyDown="MessageBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Отправить"
                        Width="80"
                        Height="38"
                        Margin="8,0,0,0"
                        Background="#3498DB"
                        Foreground="White"
                        FontSize="13"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>