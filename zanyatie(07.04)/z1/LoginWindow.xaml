<Window x:Class="z1.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный дневник"
        Height="380"
        Width="420"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#FFFFFF">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Электронный дневник"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,30"/>

        <TextBlock Grid.Row="1"
                   Text="Логин"
                   FontSize="13"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,5"/>

        <TextBox x:Name="UsernameBox"
                 Grid.Row="2"
                 Height="40"
                 FontSize="14"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1"
                 VerticalContentAlignment="Center"/>

        <TextBlock Grid.Row="3"
                   Text="Пароль"
                   FontSize="13"
                   Foreground="#7F8C8D"
                   Margin="0,15,0,5"/>

        <PasswordBox x:Name="PasswordBox"
                     Grid.Row="4"
                     Height="40"
                     FontSize="14"
                     BorderBrush="#BDC3C7"
                     BorderThickness="1"
                     VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,25,0,0">

            <Button Content="Вход"
                    Width="100"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="#3498DB"
                    Foreground="White"
                    FontSize="14"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

            <Button Content="Регистрация"
                    Width="100"
                    Height="38"
                    Background="#ECF0F1"
                    Foreground="#2C3E50"
                    FontSize="14"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="RegisterButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="ErrorText"
                   Grid.Row="6"
                   Foreground="#E74C3C"
                   FontSize="12"
                   HorizontalAlignment="Center"
                   Margin="0,15,0,0"/>
    </Grid>
</Window>