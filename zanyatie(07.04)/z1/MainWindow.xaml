<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:z1"
        Title="Электронный дневник"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernListBox" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#3498DB"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#ECF0F1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#2C3E50">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Электронный дневник"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Text="{Binding CurrentUser.FullName}"
                               Foreground="#BDC3C7"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <TextBlock Text="{Binding CurrentUser.Role}"
                               Foreground="#3498DB"
                               FontSize="12"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"/>

                    <Button Content="Загрузить"
                            Command="{Binding LoadDataCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#3498DB"
                            Height="30"
                            Width="80"
                            Margin="5,0"/>

                    <Button Content="Сохранить"
                            Command="{Binding SaveDataCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#27AE60"
                            Height="30"
                            Width="80"
                            Margin="5,0"/>

                    <Button Content="Чат"
                            Command="{Binding OpenChatCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#9B59B6"
                            Height="30"
                            Width="80"
                            Margin="5,0"/>

                    <Button Content="Задания"
                            Command="{Binding OpenAssignmentsCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#E67E22"
                            Height="30"
                            Width="80"
                            Margin="5,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#F8F9FA"
                    Margin="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Студенты"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="15,15,0,10"/>

                    <ListBox ItemsSource="{Binding Students}"
                             SelectedItem="{Binding SelectedStudent}"
                             DisplayMemberPath="FullName"
                             Style="{StaticResource ModernListBox}"
                             Height="Auto"
                             Margin="10,0,10,10"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="#F8F9FA">
                <StackPanel Margin="15">
                    <TextBlock Text="{Binding SelectedStudent.FullName, FallbackValue='Выберите студента'}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="#2C3E50"
                               Margin="0,5,0,10"/>

                    <Border Background="#EBF5FB"
                            Padding="15"
                            Margin="0,0,0,15">
                        <TextBlock FontSize="14"
                                   Foreground="#2C3E50">
                            <Run Text="Средний балл:" FontWeight="Normal"/>
                            <Run Text="{Binding SelectedStudentAverageGrade, Mode=OneWay}"
                                 FontSize="22"
                                 FontWeight="Bold"
                                 Foreground="#3498DB"/>
                        </TextBlock>
                    </Border>

                    <Border Height="1" Background="#E0E4E8" Margin="0,0,0,12"/>

                    <ListView ItemsSource="{Binding SelectedStudentGrades}"
                              BorderThickness="0"
                              Background="Transparent"
                              Height="280"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Предмет"
                                                Width="140"
                                                DisplayMemberBinding="{Binding Subject}"/>

                                <GridViewColumn Header="Оценка"
                                                Width="60"
                                                DisplayMemberBinding="{Binding GradeValue}"/>

                                <GridViewColumn Header="Дата"
                                                Width="90"
                                                DisplayMemberBinding="{Binding Date, StringFormat='dd.MM.yyyy'}"/>
                            </GridView>
                        </ListView.View>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="8,6"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <Button Content="Добавить оценку"
                            Command="{Binding AddGradeCommand}"
                            Style="{StaticResource ModernButton}"
                            Background="#27AE60"
                            HorizontalAlignment="Right"
                            Width="120"
                            Height="34"
                            Margin="0,15,0,0"
                            Visibility="{Binding CanEditGrades, Converter={StaticResource BoolToVisibility}}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="White"
                Padding="20,15"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Загрузка данных..."
                           Foreground="#2C3E50"
                           FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>