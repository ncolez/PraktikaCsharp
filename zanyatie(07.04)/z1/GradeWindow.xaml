<Window x:Class="z1.GradeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая оценка"
        Height="400"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FFFFFF">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Выставление оценки"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1"
                   Text="Студент"
                   FontSize="12"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,5"/>

        <Border Grid.Row="2"
                Background="#F0F3F4"
                Padding="12,10"
                Margin="0,0,0,15">
            <TextBlock x:Name="StudentNameText"
                       FontSize="14"
                       Foreground="#2C3E50"/>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="Предмет"
                   FontSize="12"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="SubjectCombo"
                  Grid.Row="4"
                  Height="38"
                  FontSize="13"
                  Padding="10,0"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1"
                  Margin="0,0,0,15"
                  VerticalContentAlignment="Center"
                  SelectedIndex="0">
            <ComboBoxItem Content="Математика"/>
            <ComboBoxItem Content="Физика"/>
            <ComboBoxItem Content="Программирование"/>
            <ComboBoxItem Content="Английский язык"/>
            <ComboBoxItem Content="Русский язык"/>
            <ComboBoxItem Content="Литература"/>
            <ComboBoxItem Content="Химия"/>
            <ComboBoxItem Content="Биология"/>
            <ComboBoxItem Content="История"/>
        </ComboBox>

        <TextBlock Grid.Row="5"
                   Text="Оценка (1-10)"
                   FontSize="12"
                   Foreground="#7F8C8D"
                   Margin="0,0,0,5"/>

        <ComboBox x:Name="GradeCombo"
                  Grid.Row="6"
                  Height="38"
                  FontSize="13"
                  Padding="10,0"
                  BorderBrush="#BDC3C7"
                  BorderThickness="1"
                  Margin="0,0,0,25"
                  VerticalContentAlignment="Center"
                  SelectedIndex="3">
            <ComboBoxItem Content="1"/>
            <ComboBoxItem Content="2"/>
            <ComboBoxItem Content="3"/>
            <ComboBoxItem Content="4"/>
            <ComboBoxItem Content="5"/>
            <ComboBoxItem Content="6"/>
            <ComboBoxItem Content="7"/>
            <ComboBoxItem Content="8"/>
            <ComboBoxItem Content="9"/>
            <ComboBoxItem Content="10"/>
        </ComboBox>

        <StackPanel Grid.Row="7"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Отмена"
                    Width="100"
                    Height="38"
                    Margin="0,0,15,0"
                    Background="#ECF0F1"
                    Foreground="#7F8C8D"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CancelButton_Click"/>

            <Button Content="Сохранить"
                    Width="100"
                    Height="38"
                    Background="#27AE60"
                    Foreground="White"
                    FontSize="13"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="OkButton_Click"/>
        </StackPanel>
    </Grid>
</Window>