@model BookLibrary.Models.Book

@{
    ViewData["Title"] = "Удаление книги";
}

<h1>Удаление книги</h1>

<div class="alert alert-danger">
    <h3>Вы уверены, что хотите удалить эту книгу?</h3>
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Автор</dt>
        <dd class="col-sm-10">@Model.Author</dd>

        <dt class="col-sm-2">Жанр</dt>
        <dd class="col-sm-10">@Model.Genre</dd>

        <dt class="col-sm-2">Год издания</dt>
        <dd class="col-sm-10">@Model.Year</dd>
    </dl>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Удалить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>