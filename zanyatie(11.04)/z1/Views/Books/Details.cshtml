@model BookLibrary.ViewModels.BookViewModel

@{
    ViewData["Title"] = "Детали книги";
}

<h1>Детали книги</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Автор</dt>
        <dd class="col-sm-10">@Model.Author</dd>

        <dt class="col-sm-2">ISBN</dt>
        <dd class="col-sm-10">@Model.ISBN</dd>

        <dt class="col-sm-2">Жанр</dt>
        <dd class="col-sm-10">@Model.Genre</dd>

        <dt class="col-sm-2">Год издания</dt>
        <dd class="col-sm-10">@Model.Year</dd>
    </dl>
</div>

<div>
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>