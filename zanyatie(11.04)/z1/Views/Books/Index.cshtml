@model List<BookLibrary.ViewModels.BookViewModel>

@{
    ViewData["Title"] = "Список книг";
}

<h1>Библиотека книг</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<p>
    <a asp-action="Create" class="btn btn-primary">Добавить книгу</a>
</p>

@if (!Model.Any())
{
    <div class="alert alert-info">
        В библиотеке пока нет книг. Добавьте первую книгу!
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Название</th>
                <th>Автор</th>
                <th>ISBN</th>
                <th>Жанр</th>
                <th>Год</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Title</td>
                    <td>@item.Author</td>
                    <td>@item.ISBN</td>
                    <td>@item.Genre</td>
                    <td>@item.Year</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Подробнее</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}