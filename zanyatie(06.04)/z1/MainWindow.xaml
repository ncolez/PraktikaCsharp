<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:z1"
        Title="Электронный дневник студента"
        Height="500"
        Width="700">

    <Window.DataContext>
        <vm:StudentViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <DataTemplate x:Key="GradeTemplate">
            <Border BorderThickness="0" Margin="0">
                <Grid Margin="0,4,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1.5*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Subject}" FontSize="13"/>
                    <TextBlock Grid.Column="1" Text="{Binding GradeValue}" FontSize="13" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding Date, StringFormat='dd.MM.yyyy'}" FontSize="11" Foreground="Gray" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Электронный дневник студента" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="Загрузить" Command="{Binding LoadDataCommand}" Width="80" Margin="5"/>
            <Button Content="Добавить оценку" Command="{Binding AddGradeCommand}" Width="100" Margin="5"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" 
                     ItemsSource="{Binding Students}" 
                     SelectedItem="{Binding SelectedStudent}"
                     DisplayMemberPath="FullName"
                     Margin="0,0,10,0"
                     BorderThickness="0"/>

            <Border Grid.Column="1" Background="#E3F2FD" CornerRadius="5" Padding="10" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedStudent.FullName, FallbackValue='Выберите студента'}" 
                               FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                    <Border Background="#BBDEFB" CornerRadius="5" Padding="8" Margin="0,0,0,15">
                        <TextBlock FontSize="14" TextAlignment="Center">
                            Средний балл: 
                            <TextBlock Text="{Binding SelectedStudentAverageGrade, Mode=OneWay}" 
                                       FontSize="18" FontWeight="Bold" Foreground="#1976D2"/>
                        </TextBlock>
                    </Border>

                    <Border Height="1" Background="#90CAF9" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Предмет" FontWeight="Bold" FontSize="12" Foreground="#555"/>
                        <TextBlock Grid.Column="1" Text="Оценка" FontWeight="Bold" FontSize="12" Foreground="#555" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="Дата" FontWeight="Bold" FontSize="12" Foreground="#555" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListBox ItemsSource="{Binding SelectedStudentGrades}" 
                             ItemTemplate="{StaticResource GradeTemplate}"
                             BorderThickness="0"
                             Height="250"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Background="#FFF3E0" CornerRadius="5" Padding="10" 
                VerticalAlignment="Center" HorizontalAlignment="Center"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Загрузка..." Foreground="#E65100" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>