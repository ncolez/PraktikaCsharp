<Window x:Class="z1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Электронный дневник студента" Height="500" Width="700"
        Background="#F5F5F5">

    <Window.Resources>
        <DataTemplate x:Key="GradeTemplate">
            <Border Background="White" BorderBrush="#2196F3" BorderThickness="1" 
                    Margin="5" Padding="10" CornerRadius="5">
                <StackPanel>
                    <TextBlock Text="{Binding StudentName}" FontWeight="Bold" FontSize="14" Foreground="#333"/>
                    <TextBlock Text="{Binding Subject}" FontSize="12" Foreground="#666" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Grade}" FontSize="18" FontWeight="Bold" 
                               Foreground="#2196F3" Margin="0,5,0,0"/>
                    <TextBlock Text="{Binding Date}" FontSize="10" Foreground="#999" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <ControlTemplate x:Key="UpdateButtonTemplate" TargetType="Button">
            <Border Background="#2196F3" CornerRadius="3" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✓ " FontSize="12" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="White"/>
                </StackPanel>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="AddButtonTemplate" TargetType="Button">
            <Border Background="#2196F3" CornerRadius="3" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="+ " FontSize="12" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="White"/>
                </StackPanel>
            </Border>
        </ControlTemplate>

        <ControlTemplate x:Key="DeleteButtonTemplate" TargetType="Button">
            <Border Background="#F44336" CornerRadius="3" Padding="8,4">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✖ " FontSize="12" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="White"/>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Электронный дневник студента" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="#333"/>

        <Border Grid.Row="1" Background="#E3F2FD" CornerRadius="5" Padding="8" Margin="0,0,0,15">
            <TextBlock FontSize="14" TextAlignment="Center">
                Средний балл: 
                <TextBlock Text="{Binding AverageGrade, Mode=OneWay}" 
                          FontWeight="Bold" FontSize="16" Foreground="#1976D2"/>
            </TextBlock>
        </Border>

        <ListView Grid.Row="2" 
                  ItemsSource="{Binding Grades}" 
                  ItemTemplate="{StaticResource GradeTemplate}"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="Добавить" 
                    Command="{Binding AddGradeCommand}"
                    Template="{StaticResource AddButtonTemplate}"
                    Width="80" Height="30" Margin="5"/>
            <Button Content="Удалить" 
                    Command="{Binding DeleteGradeCommand}"
                    Template="{StaticResource DeleteButtonTemplate}"
                    Width="80" Height="30" Margin="5"/>
            <Button Content="Обновить" 
                    Command="{Binding UpdateAverageCommand}"
                    Template="{StaticResource UpdateButtonTemplate}"
                    Width="80" Height="30" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>